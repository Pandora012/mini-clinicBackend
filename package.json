{
  "name": "mini-clinic-backend",
  "version": "1.0.0",
  "description": "Mini Clinic Information System Backend",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "admin:create": "node scripts/createAdmin.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate --config config/config.js",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/config.js",
    "seed": "sequelize-cli db:seed:all --config config/config.js"
  },
  "keywords": [
    "clinic",
    "healthcare",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
